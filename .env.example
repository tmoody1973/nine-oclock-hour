# Server-only. Local value lives in ~/.config/npr-cds/token — never commit the real one.
NPR_CDS_TOKEN=
# Issued by Vercel when you add Blob storage to the project.
BLOB_READ_WRITE_TOKEN=
# Any long random string; the cron route rejects requests without it.
CRON_SECRET=
# Voices the reads. Required — lib/reads.ts writes and speaks every item with no tape.
GEMINI_API_KEY=
# Optional. When set, lib/reads.ts speaks with ElevenLabs instead of Gemini (Tarik's paid
# subscription, better voice); unset falls back to Gemini, the zero-subscription path.
ELEVENLABS_API_KEY=
