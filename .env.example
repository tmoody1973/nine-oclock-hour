# Server-only. Local value lives in ~/.config/npr-cds/token — never commit the real one.
NPR_CDS_TOKEN=
# Issued by Vercel when you add Blob storage to the project.
BLOB_READ_WRITE_TOKEN=
# Any long random string; the cron route rejects requests without it.
CRON_SECRET=
# Voices the reads. Required — lib/reads.ts writes and speaks every item with no tape.
GEMINI_API_KEY=
# Optional. One of the names in lib/voices.ts (case-sensitive). Overrides which voice the
# 5 a.m. cron uses — defaults to DEFAULT_VOICE when unset. The in-app audition picker only
# previews voices in the browser; this is the actual lever for the morning build.
READ_VOICE=
